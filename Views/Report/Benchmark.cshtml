@model BenchmarkReportViewModel
@{
    ViewData["Title"] = $"Benchmark · {Model.AssessmentTitle}";
}

<div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Compliance benchmark</h1>
        <p class="text-muted mb-0">Assessment Id @Model.AssessmentId · Audience @Model.UserDisplay</p>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-danger" asp-action="Pdf" asp-route-assessmentId="@Model.AssessmentId">
            Export PDF report
        </a>
        <a class="btn btn-outline-secondary" asp-controller="Assessment" asp-action="Manage" asp-route-id="@Model.AssessmentId">
            Continue assessment
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-start border-primary border-4">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Security score</div>
                <div class="display-6 fw-bold text-primary">@Model.SecurityScore</div>
                <small class="text-muted">Applicable scope only.</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Compliance</div>
                <div class="fs-3 fw-bold">@Model.CompliancePct.ToString("0.#")%</div>
                <div class="progress" style="height:8px;">
                    <div class="progress-bar bg-success" style="width:@($"{Model.CompliancePct}%");"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Residual risk band</div>
                @if (Model.RiskLevel == RiskLevel.High)
                {
                    <span class="badge bg-danger mt-2">High</span>
                }
                else if (Model.RiskLevel == RiskLevel.Medium)
                {
                    <span class="badge bg-warning text-dark mt-2">Medium</span>
                }
                else
                {
                    <span class="badge bg-success mt-2">Low</span>
                }
                <p class="small text-muted mb-0 mt-2">
                    Driven by conformance and concentration of failures on higher ASVS levels.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Status mix</div>
                <div class="small">
                    Valid <strong>@Model.Valid</strong> · Fail <strong>@Model.NotValid</strong> ·
                    Pending <strong>@Model.Pending</strong><br/>
                    Project N/A <strong>@Model.UserMarkedNotApplicable</strong> ·
                    Source N/A rows <strong>@Model.GlobalNotApplicable</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<h2 class="h5 mb-3">Chapter analysis</h2>
<div class="table-responsive mb-5 shadow-sm">
    <table class="table table-sm table-striped">
        <thead class="table-light">
        <tr>
            <th>Chapter</th>
            <th>Applicable</th>
            <th>Valid</th>
            <th>Not valid</th>
            <th>Pending</th>
            <th>%</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Chapters)
        {
            <tr>
                <td>@c.Chapter</td>
                <td>@c.Applicable</td>
                <td>@c.Valid</td>
                <td>@c.NotValid</td>
                <td>@c.Pending</td>
                <td class="fw-semibold">@c.CompliancePct.ToString("0.#")%</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<h2 class="h5 mb-3">Weak areas (focus remediation)</h2>
@if (Model.WeakAreas.Count == 0)
{
    <p class="text-muted">Not enough heterogeneous data.</p>
}
else
{
    <ul class="list-group mb-5">
        @foreach (var w in Model.WeakAreas)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold">@w.Chapter</span>
                    <span class="badge bg-secondary">@w.CompliancePct.ToString("0.#")%</span>
                </div>
                <small class="text-muted">@w.Rationale</small>
            </li>
        }
    </ul>
}
