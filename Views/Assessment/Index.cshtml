@model AssessmentIndexViewModel
@{
    ViewData["Title"] = "My assessments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Assessments</h1>
    <a class="btn btn-primary" asp-action="Create">New assessment</a>
</div>

@if (Model.Assessments.Count == 0)
{
    <p class="text-muted">You have no assessments yet. Create one to track ASVS status.</p>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var a in Model.Assessments)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div class="fw-semibold">@a.Title</div>
                    <small class="text-muted">Created @a.CreatedUtc.ToString("u")@(a.UpdatedUtc != null ? $" · Updated {a.UpdatedUtc:u}" : "")</small>
                </div>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-primary" asp-action="Manage" asp-route-id="@a.Id">Assess</a>
                    <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index" asp-route-assessmentId="@a.Id">Dashboard</a>
                    <a class="btn btn-outline-secondary" asp-controller="Report" asp-action="Benchmark" asp-route-assessmentId="@a.Id">Report</a>
                    <a class="btn btn-outline-danger" asp-controller="Report" asp-action="Pdf" asp-route-assessmentId="@a.Id">PDF</a>
                </div>
            </div>
        }
    </div>
}
