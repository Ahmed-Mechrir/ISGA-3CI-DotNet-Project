<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - ASVS Security Auditor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
    <link rel="stylesheet" asp-append-version="true" href="~/css/app-theme.css" />
</head>
<body>
<div class="app-shell d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark sticky-top app-navbar">
    <div class="container app-main-inner px-4">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="app-brand-mark">A</span>
            <span class="d-none d-sm-inline">ASVS Auditor</span>
        </a>
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto py-3 py-lg-0">
                <li class="nav-item">
                    <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-3x3-gap pe-2"></i>Checklist</a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="Assessment" asp-action="Index"><i class="bi bi-clipboard2-check pe-2"></i>Assessments</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 pe-2"></i>Dashboard</a>
                    </li>
                    @if (User.IsInRole(AsvsSecurityAuditor.Security.Roles.Admin))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-shield-lock pe-2"></i>Admin</a>
                            <ul class="dropdown-menu dropdown-menu-dark border-0">
                                <li><a class="dropdown-item rounded-3 mx-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house-gear pe-2"></i>Admin home</a></li>
                                <li><a class="dropdown-item rounded-3 mx-2" asp-area="Admin" asp-controller="Import" asp-action="Index"><i class="bi bi-file-earmark-arrow-up pe-2"></i>Import CSV</a></li>
                                <li><a class="dropdown-item rounded-3 mx-2" asp-area="Admin" asp-controller="Requirements" asp-action="Index"><i class="bi bi-list-columns-reverse pe-2"></i>Requirements</a></li>
                            </ul>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav ms-auto gap-lg-2 align-items-lg-center pb-3 pb-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item px-3">
                        <span class="text-white-50 small text-break"><i class="bi bi-person-circle pe-1"></i>@User.Identity.Name</span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline px-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">Log out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm rounded-pill px-3 mx-3 mx-lg-0" asp-controller="Account" asp-action="Login">Log in</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-light btn-sm text-primary fw-semibold rounded-pill px-3 mx-3 mx-lg-0 mt-2 mt-lg-0" asp-controller="Account" asp-action="Register">Register</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
<main role="main" class="app-shell py-4 flex-grow-1">
    <div class="container mb-5 app-main-inner px-4">
        @if (TempData["Flash"] is string flash)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-app border-0" role="alert">
                @flash
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["FlashError"] is string ferr)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-app border-0" role="alert">
                @ferr
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</main>
<footer class="app-footer py-4 mt-auto">
    <div class="container app-main-inner px-4">
        <div class="text-secondary small">&copy; @DateTime.UtcNow.Year ASVS Security Auditor</div>
    </div>
</footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
