@model IReadOnlyList<RequirementListViewModel>
@{
    ViewData["Title"] = "Requirements";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 mb-0">Requirements</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">Add requirement</a>
</div>

<div class="table-responsive shadow-sm bg-white rounded">
    <table class="table table-sm table-striped mb-0">
        <thead class="table-light">
        <tr>
            <th>Ref</th>
            <th>Chapter</th>
            <th>Area</th>
            <th>Level</th>
            <th>Src N/A</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.RequirementRef</td>
                <td>@r.Chapter</td>
                <td>@r.Area</td>
                <td>@r.Level</td>
                <td>@r.PreMarkedNotApplicable</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-link btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-link btn-sm text-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
