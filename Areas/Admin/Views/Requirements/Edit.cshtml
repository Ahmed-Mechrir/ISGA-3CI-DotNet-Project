@model RequirementEditViewModel
@{
    ViewData["Title"] = "Edit requirement";
}

<h1 class="h4 mb-3">Edit @Model.RequirementRef</h1>

<form asp-action="Edit" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_RequirementFields"/>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
